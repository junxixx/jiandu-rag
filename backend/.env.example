FLASK_ENV=development
# 设为 1 时，Flask 启动不自动执行 Chroma 全量同步（脚本 import/sync_neo4j 会自行设置）
# SKIP_STARTUP_CHROMA_SYNC=1
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-jwt-secret
# 访问令牌有效分钟数；留空或 0 = 永不过期（仅本地演示）。试运行建议 60～120。
# JWT_ACCESS_MINUTES=120
# 刷新令牌有效天数
# JWT_REFRESH_DAYS=30

# API 限流（Flask-Limiter）。多实例请改为 redis://... 与 REDIS 同源
# RATELIMIT_STORAGE_URI=memory://
# RATELIMIT_DEFAULT=120 per minute

# 牍库：执行 scripts/optimize_slips_mysql.sql 建 FULLTEXT 后启用，检索大表更快
# SLIPS_USE_FULLTEXT=1
# Chroma 全量同步每批条数（默认 256）
# CHROMA_UPSERT_BATCH=256



MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=dujian_youth

REDIS_URL=redis://127.0.0.1:6379/0

NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password
# 全量同步时每批条数（scripts/sync_neo4j_from_slips.py --all / 管理端 full）
# NEO4J_SYNC_BATCH=2000

CHROMA_PERSIST_DIR=./chroma_data
EMBEDDING_MODEL=BAAI/bge-m3
# 问牍检索：0=只走 MySQL 关键词；1=同时走 Chroma 向量，再用 RRF 融合
# RAG_USE_CHROMA=1
# 1=把融合后的前 20 条交给 BGE-Reranker 精排，留下 RAG_TOP_K 条
# RAG_USE_RERANK=1
# RAG_RERANK_MODEL=BAAI/bge-reranker-base
# RAG_RRF_K=60
# RAG_MAX_REWRITES=2
# RAG_POOL=20
# RAG_TOP_K=5
# RAG_HYDE=0

DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com

CORS_ORIGINS=http://localhost:5173

# 管理端（每日简牍排期、敏感词、辩论题、查看埋点）；不设则 /api/admin/* 不可用
ADMIN_TOKEN=

# DeepJiandu 图像文件夹（含 train/val/test）；默认指向项目根下 DeepJiandu
# DEEPJIANDU_IMAGE_ROOT=
